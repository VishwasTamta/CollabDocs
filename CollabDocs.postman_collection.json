            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"ab\",\n    \"content\": \"Too short a title.\",\n    \"workspace\": \"{{workspace_id}}\",\n    \"created_by\": \"{{user_id}}\"\n}"
            }
          }
        },
        {
          "name": "Create Document - author not a member (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/documents/", "host": ["{{base_url}}"], "path": ["documents", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Unauthorised Document\",\n    \"content\": \"Carol is not a member of this workspace.\",\n    \"workspace\": \"{{workspace_id}}\",\n    \"created_by\": \"{{outsider_id}}\"\n}"
