{
  "info": {
    "name": "CollabDocs API",
    "description": "CollabDocs backend API.\n\nRun the folders top to bottom - each one saves the ids the next folder needs into collection variables, so the whole collection works from an empty database with no manual copy-pasting.\n\nSet `base_url` if your server is not on http://127.0.0.1:8000.\n\nFolders marked (owner: ...) are maintained by that module's owner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000/api" },
    { "key": "user_id", "value": "" },
    { "key": "member_id", "value": "" },
    { "key": "outsider_id", "value": "" },
    { "key": "workspace_id", "value": "" },
    { "key": "other_workspace_id", "value": "" },
    { "key": "document_id", "value": "" },
    { "key": "other_document_id", "value": "" },
    { "key": "tag_id", "value": "" },
    { "key": "tag_name", "value": "" },
    { "key": "comment_id", "value": "" },
    { "key": "reply_id", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Unique suffix so the seed requests can be re-run without hitting",
          "// the unique constraints on email, phone and tag name.",
          "if (!pm.collectionVariables.get('run_id')) {",
          "    pm.collectionVariables.set('run_id', Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Users",
      "description": "Seed data for the rest of the collection. (owner: Users module)",
      "item": [
        {
          "name": "Create User - owner",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('run_id', Date.now().toString());"]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('user_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/users/", "host": ["{{base_url}}"], "path": ["users", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"first_name\": \"Ada\",\n    \"last_name\": \"Owner\",\n    \"email\": \"ada.{{run_id}}@collabdocs.test\",\n    \"phone\": \"91{{run_id}}\"\n}"
            }
          }
        },
        {
          "name": "Create User - second member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('member_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/users/", "host": ["{{base_url}}"], "path": ["users", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"first_name\": \"Bob\",\n    \"last_name\": \"Editor\",\n    \"email\": \"bob.{{run_id}}@collabdocs.test\",\n    \"phone\": \"92{{run_id}}\"\n}"
            }
          }
        },
        {
          "name": "Create User - outsider (used for 400 cases)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('outsider_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/users/", "host": ["{{base_url}}"], "path": ["users", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"first_name\": \"Carol\",\n    \"last_name\": \"Outsider\",\n    \"email\": \"carol.{{run_id}}@collabdocs.test\",\n    \"phone\": \"93{{run_id}}\"\n}"
            }
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/users/", "host": ["{{base_url}}"], "path": ["users", ""] }
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}/",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Workspaces",
      "description": "Creating a workspace adds the owner as an admin member inside one transaction.atomic() block. (owner: Workspaces module)",
      "item": [
        {
          "name": "Create Workspace",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('owner auto-added as a member', () => pm.expect(pm.response.json().members_count).to.eql(1));",
                  "pm.collectionVariables.set('workspace_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/workspaces/", "host": ["{{base_url}}"], "path": ["workspaces", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Engineering {{run_id}}\",\n    \"owner\": \"{{user_id}}\"\n}"
            }
          }
        },
        {
          "name": "Create Workspace - second (for cross-document checks)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('other_workspace_id', pm.response.json().id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/workspaces/", "host": ["{{base_url}}"], "path": ["workspaces", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Marketing {{run_id}}\",\n    \"owner\": \"{{user_id}}\"\n}"
            }
          }
        },
        {
          "name": "Add Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/members/",
              "host": ["{{base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "members", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user\": \"{{member_id}}\",\n    \"role\": \"editor\"\n}"
            }
          }
        },
        {
          "name": "Add Member - duplicate (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/members/",
              "host": ["{{base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "members", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"user\": \"{{member_id}}\",\n    \"role\": \"viewer\"\n}"
            }
          }
        },
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/workspaces/{{workspace_id}}/members/",
              "host": ["{{base_url}}"],
              "path": ["workspaces", "{{workspace_id}}", "members", ""]
            }
          }
        },
        {
          "name": "List Workspaces",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/workspaces/", "host": ["{{base_url}}"], "path": ["workspaces", ""] }
          }
        }
      ]
    },
    {
      "name": "Documents",
      "description": "Every save - create or update - writes a new DocumentVersion in the same transaction.atomic() block, and the post_save signal writes an AuditLog row in that same transaction.",
      "item": [
        {
          "name": "Create Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('first version created', () => pm.expect(pm.response.json().version_count).to.eql(1));",
                  "pm.collectionVariables.set('document_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/documents/", "host": ["{{base_url}}"], "path": ["documents", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Q3 Architecture Review\",\n    \"content\": \"First draft. Covers the service split and the migration plan.\",\n    \"workspace\": \"{{workspace_id}}\",\n    \"created_by\": \"{{user_id}}\",\n    \"status\": \"draft\"\n}"
            }
          }
        },
        {
          "name": "Create Document - in the second workspace",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('other_document_id', pm.response.json().id);"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/documents/", "host": ["{{base_url}}"], "path": ["documents", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Campaign Brief\",\n    \"content\": \"Unrelated content, used to prove cross-document validation.\",\n    \"workspace\": \"{{other_workspace_id}}\",\n    \"created_by\": \"{{user_id}}\"\n}"
            }
          }
        },
        {
          "name": "Create Document - short title (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
