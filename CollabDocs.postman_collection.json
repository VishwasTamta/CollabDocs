            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Q3 Architecture Review\",\n    \"content\": \"Second revision. Added the rollback strategy and the cutover checklist.\",\n    \"workspace\": \"{{workspace_id}}\",\n    \"created_by\": \"{{user_id}}\",\n    \"status\": \"published\",\n    \"saved_by\": \"{{member_id}}\"\n}"
            }
          }
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/documents/", "host": ["{{base_url}}"], "path": ["documents", ""] }
          }
        },
        {
          "name": "List Documents - filters (Q OR search, __in, __gte)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/?workspace={{workspace_id}}&status_in=draft,published&search=rollback&updated_after=2020-01-01",
              "host": ["{{base_url}}"],
              "path": ["documents", ""],
              "query": [
                { "key": "workspace", "value": "{{workspace_id}}" },
                { "key": "status_in", "value": "draft,published", "description": "status__in" },
                { "key": "search", "value": "rollback", "description": "Q(title__icontains) | Q(content__icontains)" },
                { "key": "updated_after", "value": "2020-01-01", "description": "updated_at__gte" },
                { "key": "updated_before", "value": "2030-01-01", "description": "updated_at__lte", "disabled": true },
                { "key": "created_by", "value": "{{user_id}}", "disabled": true },
                { "key": "tag", "value": "{{tag_name}}", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Document Versions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('versions are numbered from 1', () => pm.expect(pm.response.json().versions[0].version_number).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/versions/",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "versions", ""]
            }
          }
        },
        {
          "name": "Document Stats (aggregate + annotate)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/stats/",
              "host": ["{{base_url}}"],
              "path": ["documents", "stats", ""],
              "query": [{ "key": "workspace", "value": "{{workspace_id}}", "disabled": true }]
            }
          }
        },
        {
          "name": "Add Tags to Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/tags/",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "tags", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tags\": [\"architecture-{{run_id}}\", \"backend-{{run_id}}\"],\n    \"actor\": \"{{user_id}}\"\n}"
            }
          }
        },
        {
          "name": "Add Tags to Document - unknown tag id (expect 404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/documents/{{document_id}}/tags/",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{document_id}}", "tags", ""]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"tag_ids\": [\"00000000-0000-0000-0000-000000000000\"]\n}"
            }
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/documents/{{other_document_id}}/",
              "host": ["{{base_url}}"],
              "path": ["documents", "{{other_document_id}}", ""]
            }
          }
        }
