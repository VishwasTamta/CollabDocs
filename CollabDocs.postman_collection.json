    {
      "name": "Comments",
      "description": "Threaded comments via a self-referential FK. The list endpoint returns top-level comments with their reply tree nested; ?include_replies=true returns the flat set.",
      "item": [
        {
          "name": "Create Comment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('comment_id', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/comments/", "host": ["{{base_url}}"], "path": ["comments", ""] },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"document\": \"{{document_id}}\",\n    \"author\": \"{{user_id}}\",\n    \"content\": \"Looks solid. One question about the cutover window.\"\n}"
            }
          }
        },
        {
          "name": "Create Reply",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
